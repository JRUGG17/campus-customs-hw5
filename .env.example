# Copy to hw5/.env if you want hw5-specific settings. Otherwise the code reads PORTKEY_API_KEY
# from the repo-root .env. Never commit a real .env.

PORTKEY_API_KEY=your-portkey-api-key-here

# Every agent uses this one model (these are the defaults)
PORTKEY_MODEL=gpt-6 luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
